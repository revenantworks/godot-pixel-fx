; Engine configuration file.
; Pixel FX Starter demo project. Godot 4.7.

config_version=5

[application]

config/name="Pixel FX Starter"
config/description="Five free 2D shaders that keep pixel art crisp, with one demo scene."
config/version="0.1.0"
run/main_scene="res://demo/demo.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[rendering]

textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.1, 0.1, 0.12, 1)
